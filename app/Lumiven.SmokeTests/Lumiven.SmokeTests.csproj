<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Lumiven/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../Lumiven/Services/AppServices.cs" Link="Services/AppServices.cs" />
    <Compile Include="../Lumiven/Services/Localizer.cs" Link="Services/Localizer.cs" />
    <Compile Include="../Lumiven/Services/EngineClient.cs" Link="Services/EngineClient.cs" />
    <Compile Include="../Lumiven/Services/LibraryService.cs" Link="Services/LibraryService.cs" />
    <Compile Include="../Lumiven/Services/TrayService.cs" Link="Services/TrayService.cs" />
    <Compile Include="../Lumiven/Services/UpdateService.cs" Link="Services/UpdateService.cs" />
    <Compile Include="../Lumiven/Services/DouyinShortLink.cs" Link="Services/DouyinShortLink.cs" />
    <Compile Include="../Lumiven/Services/VideoLinkHttp.cs" Link="Services/VideoLinkHttp.cs" />
    <Compile Include="../Lumiven/Services/XiaohongshuLink.cs" Link="Services/XiaohongshuLink.cs" />
    <Compile Include="../Lumiven/Services/LinkDownloadService.cs" Link="Services/LinkDownloadService.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Lumiven/Localization/*.en.json" Link="Localization/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
