            <Border Style="{StaticResource GlassPanel}" Padding="32"><StackPanel Spacing="16"><Image Source="Assets/Logo.svg" Width="74" Height="74" HorizontalAlignment="Left"/><TextBlock Text="EVEING Lumiven" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><TextBlock Text="{x:Bind DisplayVersion}" Foreground="{ThemeResource AccentBrush}"/><TextBlock controls:Localized.Text="视频号下载与媒体管理，为灵感留一个位置。" Foreground="{ThemeResource MutedBrush}" FontSize="14" TextWrapping="Wrap"/><Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,8"/><TextBlock controls:Localized.Text="由 EVEING 开发与维护，基于 GitHub 开源项目 nobiyou/wx_channel 开发。感谢原始项目 ltaoo/wx_channels_download、Gopeed、SunnyNet 及相关开源组件的贡献。" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap" LineHeight="24"/><TextBlock controls:Localized.Text="本软件免费提供。请尊重内容创作者的版权，合法使用下载内容。EVEING 新增代码以 GPL-3.0-only 开源，上游组件保留各自许可。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22"/><TextBlock x:Name="KernelVersionText" controls:Localized.Text="内核来源：nobiyou/wx_channel · 889abf89" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><HyperlinkButton controls:Localized.Content="GitHub 项目" NavigateUri="https://github.com/0399199-stack/eveing-lumiven" Padding="0"/><HyperlinkButton controls:Localized.Content="上游项目" NavigateUri="https://github.com/nobiyou/wx_channel" Padding="0"/></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource GlassPanel}">
              <StackPanel Spacing="10">
                <TextBlock controls:Localized.Text="开发与免费声明" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock controls:Localized.Text="本软件由 EVEING 开发与维护，官方版本免费提供，源代码公开。" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap" LineHeight="24"/>
