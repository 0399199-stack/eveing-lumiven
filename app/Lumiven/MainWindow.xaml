<Window x:Class="Lumiven.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lumiven.Controls"
    xmlns:models="using:Lumiven.Models"
    Title="EVEING Lumiven">
  <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" Loaded="Root_Loaded">
    <Grid x:Name="AmbientLayer" IsHitTestVisible="False" Opacity="0.65"><Image Source="Assets/Ambient.svg" Stretch="UniformToFill"/></Grid>
    <Grid RowSpacing="0" ColumnSpacing="2" Padding="16,0,16,16">
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="Assets/Logo.svg" Width="18" Height="18" Margin="3,0,2,0"/>
          <TextBlock Text="EVEING" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{ThemeResource PrimaryBrush}" />
          <TextBlock Text="/" Foreground="{ThemeResource MutedBrush}" Opacity="0.5" />
          <TextBlock Text="LUMIVEN" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{ThemeResource PrimaryBrush}" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{ThemeResource PanelShadeBrush}" CornerRadius="23" Margin="2,5,0,-3" IsHitTestVisible="False"/>
      <Border Grid.Row="1" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1.4" CornerRadius="22" Padding="10,36,10,28">
        <Grid RowSpacing="34">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.RowSpan="3" BorderBrush="{ThemeResource HighlightBrush}" BorderThickness="1" CornerRadius="18" Margin="-6,-30,-6,-22" IsHitTestVisible="False"/>
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Image Source="Assets/Logo.svg" Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock Text="Lumiven" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="EVEING" FontSize="10" CharacterSpacing="260" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="6">
            <Grid><Button x:Name="DownloadsNav" Style="{StaticResource NavButton}" Tag="downloads" Click="Navigate_Click" AutomationProperties.Name="下载中"><StackPanel Orientation="Horizontal" Spacing="15"><controls:LineIcon Kind="Download" Foreground="{Binding Foreground, ElementName=DownloadsNav}"/><TextBlock Text="下载中" VerticalAlignment="Center"/></StackPanel></Button><Border x:Name="DownloadsIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Tag="library" Click="Navigate_Click" AutomationProperties.Name="已下载"><StackPanel Orientation="Horizontal" Spacing="15"><controls:LineIcon Kind="Library" Foreground="{Binding Foreground, ElementName=LibraryNav}"/><TextBlock Text="已下载" VerticalAlignment="Center"/></StackPanel></Button><Border x:Name="LibraryIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Navigate_Click" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal" Spacing="15"><controls:LineIcon Kind="Settings" Foreground="{Binding Foreground, ElementName=SettingsNav}"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></Button><Border x:Name="SettingsIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="AboutNav" Style="{StaticResource NavButton}" Tag="about" Click="Navigate_Click" AutomationProperties.Name="关于"><StackPanel Orientation="Horizontal" Spacing="15"><controls:LineIcon Kind="About" Foreground="{Binding Foreground, ElementName=AboutNav}"/><TextBlock Text="关于" VerticalAlignment="Center"/></StackPanel></Button><Border x:Name="AboutIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="10" Margin="9,0,9,8">
            <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Spacing="9"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{ThemeResource MutedBrush}" Stroke="#D8F5FF" StrokeThickness="1"/><TextBlock x:Name="ConnectionLabel" Text="尚未启用" Foreground="{ThemeResource PrimaryBrush}" FontSize="12"/></StackPanel>
            <TextBlock Text="免费 · 开源" Foreground="{ThemeResource MutedBrush}" FontSize="12" Margin="18,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource PanelShadeBrush}" CornerRadius="23" Margin="2,5,0,-3" IsHitTestVisible="False"/>
      <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassPanel}" CornerRadius="22" Padding="32,26,24,24"><Grid>
        <Grid x:Name="DownloadsPage" RowSpacing="22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Spacing="8" Margin="2,4,0,0"><TextBlock Text="下载中" Style="{StaticResource PageTitle}"/><TextBlock Text="微信里点击下载，Lumiven 为你接住每一份灵感。" Style="{StaticResource MutedText}"/></StackPanel>
          <Border Grid.Row="1" CornerRadius="26" Background="{ThemeResource PanelShadeBrush}" Margin="2,6,2,-6"/>
          <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="28">
            <Grid ColumnSpacing="22">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" BorderBrush="{ThemeResource HighlightBrush}" BorderThickness="1" CornerRadius="19" Margin="-20" IsHitTestVisible="False"/>
              <StackPanel Spacing="12">
                <TextBlock Text="YOUR NEXT INSPIRATION" FontSize="10" CharacterSpacing="130" Foreground="{ThemeResource AccentBrush}"/>
                <TextBlock Text="好内容，值得留下。" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/>
                <TextBlock x:Name="EngineStatusText" Text="启用微信下载后，在视频号页面点击下载按钮即可。" Foreground="{ThemeResource MutedBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="550" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <Button x:Name="EnableButton" Style="{StaticResource IceAccentButton}" Click="Enable_Click"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="启用微信下载"/></StackPanel></Button>
                  <Button x:Name="StopButton" Style="{StaticResource GlassButton}" Click="Stop_Click" IsEnabled="False" Content="停止接入"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,5,0,0"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8B7;" FontSize="10" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="本地保存" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="自动整理" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="一键回看" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></StackPanel>
              </StackPanel>
              <Grid Grid.Column="1" Width="162" Height="168" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="30" Width="126" Height="136" Margin="-15,9,0,0"><Border.RenderTransform><RotateTransform Angle="-12" CenterX="63" CenterY="68"/></Border.RenderTransform></Border>
                <Border Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1.6" CornerRadius="30" Width="126" Height="136" Margin="12,-8,0,0">
                  <Grid Padding="10"><Border BorderBrush="{ThemeResource HighlightBrush}" BorderThickness="1" CornerRadius="21"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15"><Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" Width="70" Height="70" CornerRadius="22"><FontIcon Glyph="&#xE896;" FontSize="35" Foreground="{ThemeResource AccentBrush}"/></Border><StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"><Border Background="{ThemeResource AccentBrush}" Opacity="0.4" CornerRadius="2" Height="3" Width="30"/><Border Background="{ThemeResource AccentBrush}" Opacity="0.15" CornerRadius="2" Height="3" Width="16"/></StackPanel></StackPanel></Grid>
                </Border>
                <Ellipse Width="9" Height="9" Fill="#EAFAFF" Stroke="#97D9F6" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
              </Grid>
            </Grid>
          </Border>
          <Grid Grid.Row="2"><TextBlock x:Name="QueueCount" Text="下载任务 · 0" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><Button HorizontalAlignment="Right" Style="{StaticResource GlassButton}" Padding="12,6" Click="Refresh_Click" Content="刷新"/></Grid>
          <Grid Grid.Row="3">
            <ListView x:Name="TaskList" ItemsSource="{x:Bind Tasks}" SelectionMode="None" Background="Transparent" Padding="0,0,0,6" HorizontalContentAlignment="Stretch" ContainerContentChanging="TaskList_ContainerContentChanging">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadTask">
                  <Border Style="{StaticResource GlassPanel}" CornerRadius="20" Padding="20">
                    <Grid RowSpacing="10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Border Width="42" Height="42" CornerRadius="13" Background="{ThemeResource AccentSoftBrush}"><FontIcon Glyph="&#xE714;" FontSize="19" Foreground="{ThemeResource AccentBrush}"/></Border>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource PrimaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Author, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{x:Bind Quality, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource StatusConverter}}" Style="{StaticResource MutedText}" FontSize="11"/>
                      <controls:SmoothProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" TargetValue="{x:Bind Progress, Mode=OneWay}" TotalBytes="{x:Bind BytesTotal, Mode=OneWay}" TaskStatus="{x:Bind Status, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2"/>
                      <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"><TextBlock Text="{x:Bind Error, Mode=OneWay}" Foreground="#C65A69" FontSize="11" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/><TextBlock HorizontalAlignment="Right" Text="{Binding BytesReceived, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource MutedText}" FontSize="11"/></Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="QueueEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,20">
              <FontIcon Glyph="&#xE896;" FontSize="34" Foreground="{ThemeResource MutedBrush}" Opacity="0.4"/>
              <TextBlock Text="还没有下载任务" FontSize="15" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="启用接入 → 打开微信视频号 → 点击下载" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="LibraryPage" Visibility="Collapsed" RowSpacing="20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="2,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock Text="已下载" Style="{StaticResource PageTitle}"/><TextBlock x:Name="LibrarySubtitle" Text="让好内容，拥有一个舒服的归处。" Foreground="{ThemeResource PrimaryBrush}" FontSize="14"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top"><Button Style="{StaticResource GlassButton}" Click="Import_Click" Padding="16,12"><StackPanel Orientation="Horizontal" Spacing="9"><controls:LineIcon Kind="Import" Width="20" Height="20"/><TextBlock Text="导入旧目录" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource GlassButton}" Click="Refresh_Click" Padding="16,12"><StackPanel Orientation="Horizontal" Spacing="9"><controls:LineIcon Kind="Refresh" Width="20" Height="20"/><TextBlock Text="刷新" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Grid>
          <Border Grid.Row="1" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1.3" CornerRadius="17" Padding="16,4" Height="48"><Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Search" Foreground="{ThemeResource MutedBrush}"/><AutoSuggestBox Grid.Column="1" x:Name="LibrarySearch" PlaceholderText="搜索视频标题或作者" TextChanged="Search_TextChanged" Background="Transparent" BorderThickness="0" CornerRadius="10" VerticalAlignment="Center" FontSize="15"/></Grid></Border>
          <Grid Grid.Row="2">
            <GridView x:Name="MediaGrid" ItemsSource="{x:Bind FilteredMedia}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Media_ItemClick" ContainerContentChanging="MediaGrid_ContainerContentChanging" SizeChanged="MediaGrid_SizeChanged" Padding="0,0,0,12" Background="Transparent" HorizontalContentAlignment="Stretch">
              <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></GridView.ItemsPanel>
              <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="CornerRadius" Value="22"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                  <Grid controls:Motion.Enabled="True">
                    <Border Background="{ThemeResource PanelShadeBrush}" CornerRadius="21" Margin="2,5,2,-2" IsHitTestVisible="False"/>
                    <Border Style="{StaticResource CardPanel}" Padding="10" CornerRadius="21">
                    <Grid RowSpacing="0"><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="14"><Grid x:Name="CoverFrame" SizeChanged="CoverFrame_SizeChanged"><controls:LineIcon Kind="Library" Width="34" Height="34" Foreground="{ThemeResource MutedBrush}" Opacity="0.35"/><Image x:Name="VideoCover" Source="{Binding Thumbnail, Converter={StaticResource ThumbnailConverter}}" Stretch="UniformToFill"/><Border Background="#DCFDEEF0" BorderBrush="#FFDDE1" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Visibility="{Binding IsMissing, Converter={StaticResource MissingVisibilityConverter}}"><TextBlock Text="文件已移走" Foreground="#A54C59" FontSize="10"/></Border><Border Background="#88437092" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9" Padding="8,4"><TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" Foreground="White" FontSize="10"/></Border><Border Background="#885A6677" BorderBrush="#F5FFFFFF" BorderThickness="1.2" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="9"><controls:LineIcon Kind="Play" Foreground="White" Width="20" Height="20"/></Border></Grid></Border>
                      <Button Style="{StaticResource GlassButton}" Width="32" Height="32" Padding="6" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9" Tag="{x:Bind}" Click="MediaMore_Click" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="更多操作"><controls:LineIcon Kind="More" Width="20" Height="20"/></Button>
                      <Grid Grid.Row="1" Padding="2,12,1,2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Title, Mode=OneWay}" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,8,0"/><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{x:Bind Author, Mode=OneWay}" MaxWidth="75" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" FontSize="10"/><Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Visibility="{Binding Quality, Converter={StaticResource NonEmptyVisibilityConverter}}"><TextBlock Text="{x:Bind Quality, Mode=OneWay}" Foreground="{ThemeResource AccentBrush}" FontSize="10"/></Border><TextBlock Text="{Binding CompletedAt, Converter={StaticResource DateConverter}}" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel><Button Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource GlassButton}" Width="40" Height="40" Padding="9" CornerRadius="12" VerticalAlignment="Center" Tag="{x:Bind}" Click="Locate_Click" ToolTipService.ToolTip="在文件夹中查看" AutomationProperties.Name="在文件夹中查看"><controls:LineIcon Kind="Folder" Width="20" Height="20"/></Button></Grid>
                    </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource MutedBrush}" Opacity="0.4"/><TextBlock x:Name="LibraryEmptyTitle" Text="你的灵感收藏，从这里开始" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="下载完成的视频会出现在这里，也可以导入旧版下载目录。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="350" TextAlignment="Center"/></StackPanel>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="22" Padding="2,4,2,10">
            <StackPanel Spacing="8"><TextBlock Text="设置" Style="{StaticResource PageTitle}"/><TextBlock Text="让 Lumiven 更贴合你的习惯。" Style="{StaticResource MutedText}"/></StackPanel>
            <Border Style="{StaticResource GlassPanel}"><StackPanel Spacing="18"><TextBlock Text="保存与媒体库" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><TextBlock Text="视频保存目录" Foreground="{ThemeResource PrimaryBrush}"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DownloadDirectoryBox" IsReadOnly="True" CornerRadius="12" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource GlassButton}" Click="ChooseDirectory_Click" Content="更改目录"/></Grid><TextBlock Text="视频单独保存，卸载软件也会保留。更改目录后，原目录的视频仍可导入。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><Border Height="1" Background="{ThemeResource DividerBrush}"/><Grid><TextBlock Text="同时下载数量" Foreground="{ThemeResource PrimaryBrush}"/><TextBlock x:Name="ConcurrencyText" HorizontalAlignment="Right" Text="3 个" Foreground="{ThemeResource AccentBrush}"/></Grid><Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="5" StepFrequency="1" Value="3" ValueChanged="Concurrency_Changed"/><TextBlock Text="新的并发设置在下次启用微信下载时生效。" Style="{StaticResource MutedText}"/></StackPanel></Border>
            <Border Style="{StaticResource GlassPanel}"><StackPanel Spacing="18"><TextBlock Text="外观与动效" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><Grid><StackPanel Spacing="6"><TextBlock Text="主题" Foreground="{ThemeResource PrimaryBrush}"/><TextBlock Text="玻璃材质与文字自动适应主题" Style="{StaticResource MutedText}"/></StackPanel><ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right" Width="160" SelectionChanged="Theme_Changed" CornerRadius="12"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox></Grid><Border Height="1" Background="{ThemeResource DividerBrush}"/><TextBlock Text="动画和透明效果遵循 Windows 辅助功能设置。关闭窗口后保留托盘运行，可从托盘菜单彻底退出。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource GlassPanel}"><StackPanel Spacing="12"><TextBlock Text="微信接入" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><TextBlock x:Name="SettingsStatusText" Text="尚未启用" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="首次启用需要安装本软件根证书，并临时切换当前用户系统代理。使用期间，遵循系统代理的其他应用流量也会经过本机服务。停止接入或退出软件时恢复原代理，不安装网络驱动。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Click="Stop_Click" Content="停止接入并恢复代理"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="22" Padding="2,4,2,10">
            <StackPanel Spacing="8"><TextBlock Text="关于" Style="{StaticResource PageTitle}"/><TextBlock Text="认真做一个轻盈、好用的小工具。" Style="{StaticResource MutedText}"/></StackPanel>
            <Border Style="{StaticResource GlassPanel}" Padding="32"><StackPanel Spacing="16"><Image Source="Assets/Logo.svg" Width="74" Height="74" HorizontalAlignment="Left"/><TextBlock Text="EVEING Lumiven" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><TextBlock Text="{x:Bind DisplayVersion}" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="视频号下载与媒体管理，为灵感留一个位置。" Foreground="{ThemeResource MutedBrush}" FontSize="14"/><Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,8"/><TextBlock Text="由 EVEING 开发与维护，基于 GitHub 开源项目 nobiyou/wx_channel 开发。感谢原始项目 ltaoo/wx_channels_download、Gopeed、SunnyNet 及相关开源组件的贡献。" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap" LineHeight="24"/><TextBlock Text="本软件免费提供。请尊重内容创作者的版权，合法使用下载内容。EVEING 新增代码以 GPL-3.0-only 开源，上游组件保留各自许可。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22"/><TextBlock x:Name="KernelVersionText" Text="内核来源：nobiyou/wx_channel · 889abf89" Style="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal" Spacing="12"><HyperlinkButton Content="GitHub 项目" NavigateUri="https://github.com/0399199-stack/eveing-lumiven" Padding="0"/><HyperlinkButton Content="上游项目" NavigateUri="https://github.com/nobiyou/wx_channel" Padding="0"/></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource GlassPanel}"><Grid><StackPanel Spacing="8"><TextBlock Text="联系 EVEING" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><HyperlinkButton NavigateUri="mailto:0399199@gmail.com" Content="0399199@gmail.com" Padding="0" HorizontalAlignment="Left"/></StackPanel><FontIcon Glyph="&#xE715;" FontSize="28" Foreground="{ThemeResource AccentBrush}" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid></Border>
    </Grid>
    <Border x:Name="PlayerOverlay" Visibility="Collapsed" Background="#F00B1220" CornerRadius="0" Padding="28" Margin="0,58,0,0">
      <Grid RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource GlassButton}" Click="ClosePlayer_Click" AutomationProperties.Name="返回媒体库"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="PlayerTitle" Foreground="White" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayerAuthor" Foreground="#A7B6CF" FontSize="12"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GlassButton}" Click="Fullscreen_Click" ToolTipService.ToolTip="切换全屏" AutomationProperties.Name="切换全屏"><FontIcon Glyph="&#xE740;" FontSize="16"/></Button></Grid>
        <Grid Grid.Row="1" x:Name="PlayerStage"><MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform"/><Image x:Name="PlayerCover" Stretch="Uniform" IsHitTestVisible="False"/></Grid>
