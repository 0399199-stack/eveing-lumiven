      </Grid>
    </Border>
    <InfoBar x:Name="Notice" IsOpen="False" Severity="Informational" IsClosable="True" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="240,0,26,28" MaxWidth="700" CornerRadius="16" />
  </Grid>
</Window>
