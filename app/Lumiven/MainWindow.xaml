                  <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="192" SelectionChanged="Language_Changed" CornerRadius="12" controls:Localized.Name="语言"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerBrush}"/>
                <TextBlock controls:Localized.Text="动画和透明效果遵循 Windows 辅助功能设置。关闭窗口后保留托盘运行，可从托盘菜单彻底退出。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassPanel}">
              <StackPanel Spacing="14">
                <Grid><TextBlock controls:Localized.Text="软件更新" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind DisplayVersion}" HorizontalAlignment="Right" Style="{StaticResource MutedText}"/></Grid>
                <ToggleSwitch x:Name="AutomaticUpdatesToggle" controls:Localized.Header="启动时检查并自动下载更新" IsOn="True" Toggled="AutomaticUpdates_Toggled" controls:Localized.OnContent="已开启" controls:Localized.OffContent="已关闭"/>
                <TextBlock controls:Localized.Text="从 GitHub 获取正式版本，下载后先校验文件，安装前由你确认。视频与设置会保留。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
