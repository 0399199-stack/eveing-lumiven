                <TextBlock x:Name="RepairStatusText" Text="" Visibility="Collapsed" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="22" Padding="2,4,2,10">
            <StackPanel Spacing="8"><TextBlock controls:Localized.Text="关于" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/><TextBlock controls:Localized.Text="认真做一个轻盈、好用的小工具。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel>
