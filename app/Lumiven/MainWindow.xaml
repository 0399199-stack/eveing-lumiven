<Window x:Class="Lumiven.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lumiven.Controls"
    xmlns:models="using:Lumiven.Models"
    Title="EVEING Lumiven">
  <ContentControl x:Name="StartupContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
  <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" Loaded="Root_Loaded">
    <Grid.Resources>
      <DataTemplate x:Key="DownloadTaskTemplate" x:DataType="models:DownloadTask">
        <Border Style="{StaticResource GlassPanel}" CornerRadius="20" Padding="20">
          <Grid RowSpacing="10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Width="42" Height="42" CornerRadius="13" Background="{ThemeResource AccentSoftBrush}"><FontIcon Glyph="&#xE714;" FontSize="19" Foreground="{ThemeResource AccentBrush}"/></Border>
            <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource PrimaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Author, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Quality, Converter={StaticResource ErrorLocalizationConverter}}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Status, Converter={StaticResource StatusConverter}}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
              <Button controls:Localized.Content="取消" Tag="{x:Bind Id}" Click="CancelLink_Click" Style="{StaticResource GlassButton}" Padding="9,4" FontSize="11"
                  Visibility="{Binding Id, Converter={StaticResource LinkCancelVisibilityConverter}}" IsEnabled="{Binding Status, Converter={StaticResource ActiveTaskConverter}}"/>
            </StackPanel>
            <controls:SmoothProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" TargetValue="{x:Bind Progress, Mode=OneWay}" TotalBytes="{x:Bind BytesTotal, Mode=OneWay}" TaskStatus="{x:Bind Status, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2"/>
            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"><TextBlock Text="{Binding Error, Converter={StaticResource ErrorLocalizationConverter}}" Foreground="{ThemeResource ErrorBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/><TextBlock HorizontalAlignment="Right" Text="{Binding BytesReceived, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource MutedText}" FontSize="11"/></Grid>
          </Grid>
        </Border>
      </DataTemplate>
    </Grid.Resources>
    <Grid x:Name="AmbientLayer" IsHitTestVisible="False" Opacity="{ThemeResource AmbientOpacity}"><Image Source="Assets/Ambient.svg" Stretch="UniformToFill"/></Grid>
    <Grid RowSpacing="0" ColumnSpacing="2" Padding="16,0,16,16">
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="Assets/Logo.svg" Width="18" Height="18" Margin="3,0,2,0"/>
          <TextBlock Text="EVEING" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{ThemeResource PrimaryBrush}" />
          <TextBlock Text="/" Foreground="{ThemeResource MutedBrush}" Opacity="0.5" />
          <TextBlock Text="LUMIVEN" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150" Foreground="{ThemeResource PrimaryBrush}" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{ThemeResource PanelShadeBrush}" CornerRadius="23" Margin="2,5,0,-3" IsHitTestVisible="False"/>
      <Border Grid.Row="1" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1.4" CornerRadius="22" Padding="10,28,10,24">
        <Grid RowSpacing="26">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.RowSpan="3" BorderBrush="{ThemeResource HighlightBrush}" BorderThickness="1" CornerRadius="18" Margin="-6,-30,-6,-22" IsHitTestVisible="False"/>
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Image Source="Assets/Logo.svg" Width="82" Height="82" HorizontalAlignment="Center" />
            <TextBlock Text="Lumiven" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="EVEING" FontSize="10" CharacterSpacing="260" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="6">
            <Grid><Button x:Name="DownloadsNav" Style="{StaticResource NavButton}" Tag="downloads" Click="Navigate_Click" controls:Localized.Name="视频号下载"><StackPanel Orientation="Horizontal" Spacing="12"><controls:LineIcon Kind="Download" Foreground="{Binding Foreground, ElementName=DownloadsNav}"/><TextBlock controls:Localized.Text="视频号下载" VerticalAlignment="Center" MaxWidth="132" TextWrapping="Wrap"/></StackPanel></Button><Border x:Name="DownloadsIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="ParsingNav" Style="{StaticResource NavButton}" Tag="parsing" Click="Navigate_Click" controls:Localized.Name="视频解析"><StackPanel Orientation="Horizontal" Spacing="12"><controls:LineIcon Kind="ParseVideo" Foreground="{Binding Foreground, ElementName=ParsingNav}"/><TextBlock controls:Localized.Text="视频解析" VerticalAlignment="Center" MaxWidth="132" TextWrapping="Wrap"/></StackPanel></Button><Border x:Name="ParsingIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Tag="library" Click="Navigate_Click" controls:Localized.Name="已下载"><StackPanel Orientation="Horizontal" Spacing="12"><controls:LineIcon Kind="Library" Foreground="{Binding Foreground, ElementName=LibraryNav}"/><TextBlock controls:Localized.Text="已下载" VerticalAlignment="Center" MaxWidth="132" TextWrapping="Wrap"/></StackPanel></Button><Border x:Name="LibraryIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Navigate_Click" controls:Localized.Name="设置"><StackPanel Orientation="Horizontal" Spacing="12"><controls:LineIcon Kind="Settings" Foreground="{Binding Foreground, ElementName=SettingsNav}"/><TextBlock controls:Localized.Text="设置" VerticalAlignment="Center" MaxWidth="132" TextWrapping="Wrap"/></StackPanel></Button><Border x:Name="SettingsIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <Grid><Button x:Name="AboutNav" Style="{StaticResource NavButton}" Tag="about" Click="Navigate_Click" controls:Localized.Name="关于"><StackPanel Orientation="Horizontal" Spacing="12"><controls:LineIcon Kind="About" Foreground="{Binding Foreground, ElementName=AboutNav}"/><TextBlock controls:Localized.Text="关于" VerticalAlignment="Center" MaxWidth="132" TextWrapping="Wrap"/></StackPanel></Button><Border x:Name="AboutIndicator" Width="3" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="10" Margin="9,0,9,8">
            <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,0,0,10"/>
            <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{ThemeResource MutedBrush}" Stroke="#D8F5FF" StrokeThickness="1"/><TextBlock x:Name="ConnectionLabel" Grid.Column="1" Text="" Foreground="{ThemeResource PrimaryBrush}" FontSize="12" TextWrapping="Wrap"/></Grid>
            <TextBlock controls:Localized.Text="免费 · 开源" Foreground="{ThemeResource MutedBrush}" FontSize="12" Margin="18,0,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="SidebarVersionText" Text="{x:Bind ShortVersion}" Foreground="{ThemeResource MutedBrush}" FontSize="11" Opacity="0.8" Margin="18,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource PanelShadeBrush}" CornerRadius="23" Margin="2,5,0,-3" IsHitTestVisible="False"/>
      <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassPanel}" CornerRadius="22" Padding="32,26,24,24"><Grid>
        <Grid x:Name="DownloadsPage" RowSpacing="22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8" Margin="2,4,0,0"><TextBlock controls:Localized.Text="视频号下载" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/><TextBlock controls:Localized.Text="连接微信，在视频号中点击下载，文件自动收录。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Style="{StaticResource GlassButton}" VerticalAlignment="Top" Margin="0,8,0,0" Click="DownloadHelp_Click" controls:Localized.Name="使用帮助"><StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="About" Width="18" Height="18"/><TextBlock controls:Localized.Text="使用帮助" TextWrapping="Wrap"/></StackPanel></Button></Grid>
          <Border Grid.Row="1" CornerRadius="26" Background="{ThemeResource PanelShadeBrush}" Margin="2,6,2,-6"/>
          <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="28">
            <Grid ColumnSpacing="22">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" BorderBrush="{ThemeResource HighlightBrush}" BorderThickness="1" CornerRadius="19" Margin="-20" IsHitTestVisible="False"/>
              <StackPanel Spacing="12">
                <TextBlock Text="YOUR NEXT INSPIRATION" FontSize="10" CharacterSpacing="130" Foreground="{ThemeResource AccentBrush}"/>
                <TextBlock controls:Localized.Text="好内容，值得留下。" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="EngineStatusText" Text="" Foreground="{ThemeResource MutedBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="550" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <Button x:Name="EnableButton" Style="{StaticResource IceAccentButton}" Click="Enable_Click"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock controls:Localized.Text="启用微信下载" TextWrapping="Wrap"/></StackPanel></Button>
                  <Button x:Name="StopButton" Style="{StaticResource GlassButton}" Click="Stop_Click" IsEnabled="False" controls:Localized.Content="停止接入"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,5,0,0"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8B7;" FontSize="10" Foreground="{ThemeResource AccentBrush}"/><TextBlock controls:Localized.Text="本地保存" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="{ThemeResource AccentBrush}"/><TextBlock controls:Localized.Text="自动整理" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource AccentBrush}"/><TextBlock controls:Localized.Text="一键回看" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap"/></StackPanel></StackPanel>
              </StackPanel>
              <Grid Grid.Column="1" Width="162" Height="168" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="30" Width="126" Height="136" Margin="-15,9,0,0"><Border.RenderTransform><RotateTransform Angle="-12" CenterX="63" CenterY="68"/></Border.RenderTransform></Border>
                <Border Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1.6" CornerRadius="30" Width="126" Height="136" Margin="12,-8,0,0">
                  <Grid Padding="10"><Border BorderBrush="{ThemeResource HighlightBrush}" BorderThickness="1" CornerRadius="21"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15"><Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" Width="70" Height="70" CornerRadius="22"><FontIcon Glyph="&#xE896;" FontSize="35" Foreground="{ThemeResource AccentBrush}"/></Border><StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"><Border Background="{ThemeResource AccentBrush}" Opacity="0.4" CornerRadius="2" Height="3" Width="30"/><Border Background="{ThemeResource AccentBrush}" Opacity="0.15" CornerRadius="2" Height="3" Width="16"/></StackPanel></StackPanel></Grid>
                </Border>
                <Ellipse Width="9" Height="9" Fill="#EAFAFF" Stroke="#97D9F6" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
              </Grid>

            </Grid>
          </Border>
          <Grid Grid.Row="2"><TextBlock x:Name="QueueCount" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><Button HorizontalAlignment="Right" Style="{StaticResource GlassButton}" Padding="12,6" Click="Refresh_Click" controls:Localized.Content="刷新"/></Grid>
          <Grid Grid.Row="3">
            <ListView ItemTemplate="{StaticResource DownloadTaskTemplate}" x:Name="TaskList" ItemsSource="{x:Bind Tasks}" SelectionMode="None" Background="Transparent" Padding="0,0,0,6" HorizontalContentAlignment="Stretch" ContainerContentChanging="TaskList_ContainerContentChanging">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/></Style></ListView.ItemContainerStyle>

            </ListView>
            <StackPanel x:Name="QueueEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,20">
              <FontIcon Glyph="&#xE896;" FontSize="34" Foreground="{ThemeResource MutedBrush}" Opacity="0.4"/>
              <TextBlock controls:Localized.Text="还没有下载任务" FontSize="15" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock controls:Localized.Text="启用微信下载 → 打开视频号 → 点击下载" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Grid>
        <Grid x:Name="ParsingPage" Visibility="Collapsed" RowSpacing="20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Spacing="8" Margin="2,4,0,0"><TextBlock controls:Localized.Text="视频解析" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/><TextBlock controls:Localized.Text="选择平台，粘贴分享链接，保存你喜欢的视频。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel>
          <Grid Grid.Row="1" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="DouyinPlatformButton" Tag="douyin" Click="Platform_Click" Style="{StaticResource GlassButton}" Padding="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" controls:Localized.Name="抖音下载">
              <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="15" Background="{ThemeResource AccentSoftBrush}"><controls:LineIcon Kind="Douyin" Width="25" Height="25" Foreground="{ThemeResource AccentBrush}"/></Border>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock controls:Localized.Text="抖音下载" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/><TextBlock controls:Localized.Text="支持短链接与整段分享文案" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0"><controls:LineIcon Kind="Clean" Width="14" Height="14" Foreground="{ThemeResource AccentBrush}"/><TextBlock controls:Localized.Text="优先无水印源" FontSize="11" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap"/></StackPanel>
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="XhsPlatformButton" Grid.Column="1" Tag="xhs" Click="Platform_Click" Style="{StaticResource GlassButton}" Padding="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" controls:Localized.Name="小红书解析">
              <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="15" Background="{ThemeResource AccentSoftBrush}"><controls:LineIcon Kind="Xiaohongshu" Width="25" Height="25" Foreground="{ThemeResource AccentBrush}"/></Border>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock controls:Localized.Text="小红书解析" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/><TextBlock controls:Localized.Text="支持视频笔记与分享短链接" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0"><controls:LineIcon Kind="Clean" Width="14" Height="14" Foreground="{ThemeResource AccentBrush}"/><TextBlock controls:Localized.Text="优先无水印源" FontSize="11" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap"/></StackPanel>
                </StackPanel>
              </Grid>
            </Button>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="20" CornerRadius="20">
            <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><TextBlock x:Name="LinkInputTitle" Text="" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}"/><Button HorizontalAlignment="Right" Click="PasteLink_Click" Style="{StaticResource GlassButton}" Padding="10,4" FontSize="12" controls:Localized.Content="粘贴"/></Grid>
              <TextBox x:Name="LinkInput" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="130" MaxLength="8000" PlaceholderText="" controls:Localized.Name="视频分享链接"/>
              <Grid Grid.Row="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock controls:Localized.Text="直接保存平台视频源，不抹除画面中已有的水印。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="LinkDownloadButton" Grid.Column="1" Click="LinkDownload_Click" Style="{StaticResource IceAccentButton}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="Download" Width="17" Height="17" Foreground="{ThemeResource AccentButtonForeground}"/><TextBlock controls:Localized.Text="解析并下载" TextWrapping="Wrap"/></StackPanel></Button>
              </Grid>
              <TextBlock x:Name="LinkInputError" Grid.Row="3" Visibility="Collapsed" FontSize="12" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap"/>
            </Grid>
          </Border>
          <Grid Grid.Row="3" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LinkQueueCount" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ClearLinkRecordsButton" Click="ClearLinkRecords_Click" Style="{StaticResource GlassButton}" Padding="12,6" controls:Localized.Content="清除记录" controls:Localized.ToolTip="仅清除已结束的解析任务记录" IsEnabled="False"/><Button Click="Refresh_Click" Style="{StaticResource GlassButton}" Padding="12,6" controls:Localized.Content="刷新"/></StackPanel></Grid>
          <Grid Grid.Row="4">
            <ListView x:Name="LinkTaskList" ItemsSource="{x:Bind LinkTasks}" ItemTemplate="{StaticResource DownloadTaskTemplate}" ItemContainerStyle="{Binding ItemContainerStyle, ElementName=TaskList}" SelectionMode="None" Background="Transparent" HorizontalContentAlignment="Stretch" ContainerContentChanging="TaskList_ContainerContentChanging"/>
            <StackPanel x:Name="LinkQueueEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,12"><controls:LineIcon Kind="ParseVideo" Width="30" Height="30" Foreground="{ThemeResource MutedBrush}" Opacity="0.5"/><TextBlock controls:Localized.Text="从一条分享链接开始" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/><TextBlock controls:Localized.Text="下载完成后，在“已下载”中播放或定位文件" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
          </Grid>
        </Grid>
        <ContentControl x:Name="LibraryPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"><Grid RowSpacing="20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Spacing="12">
            <Grid Margin="2,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="8"><TextBlock controls:Localized.Text="已下载" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/><TextBlock x:Name="LibrarySubtitle" Text="" Foreground="{ThemeResource PrimaryBrush}" FontSize="14"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                <Button x:Name="BatchSelectButton" Style="{StaticResource GlassButton}" Click="BatchSelect_Click" Padding="16,12" controls:Localized.Name="批量选择"><StackPanel Orientation="Horizontal" Spacing="9"><controls:LineIcon Kind="Select" Width="20" Height="20"/><TextBlock x:Name="BatchSelectText" Text="" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource GlassButton}" Click="Import_Click" Padding="16,12"><StackPanel Orientation="Horizontal" Spacing="9"><controls:LineIcon Kind="Import" Width="20" Height="20"/><TextBlock controls:Localized.Text="导入旧目录" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Button>
                <Button Style="{StaticResource GlassButton}" Click="Refresh_Click" Padding="16,12"><StackPanel Orientation="Horizontal" Spacing="9"><controls:LineIcon Kind="Refresh" Width="20" Height="20"/><TextBlock controls:Localized.Text="刷新" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Button>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="BatchSelectionPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="12">
              <TextBlock x:Name="BatchSelectionCount" Text="" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center"/>
              <Button x:Name="SelectAllButton" Style="{StaticResource GlassButton}" Content="" Click="SelectAllMedia_Click"/>
              <Button x:Name="DeleteSelectedButton" Style="{StaticResource GlassButton}" controls:Localized.Content="删除记录" IsEnabled="False" Click="DeleteSelected_Click"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1.3" CornerRadius="17" Padding="16,4" Height="48"><Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:LineIcon Kind="Search" Foreground="{ThemeResource MutedBrush}"/><AutoSuggestBox Grid.Column="1" x:Name="LibrarySearch" controls:Localized.Placeholder="搜索视频标题或作者" TextChanged="Search_TextChanged" Background="Transparent" BorderThickness="0" CornerRadius="10" VerticalAlignment="Center" FontSize="15"/></Grid></Border>
          <Grid Grid.Row="2">
            <GridView x:Name="MediaGrid" ItemsSource="{x:Bind FilteredMedia}" SelectionMode="None" SelectionChanged="Media_SelectionChanged" IsItemClickEnabled="True" ItemClick="Media_ItemClick" ContainerContentChanging="MediaGrid_ContainerContentChanging" SizeChanged="MediaGrid_SizeChanged" Padding="0,0,0,12" Background="Transparent" HorizontalContentAlignment="Stretch">
              <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></GridView.ItemsPanel>
              <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="CornerRadius" Value="22"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                  <Grid controls:Motion.Enabled="True">
                    <Border Background="{ThemeResource PanelShadeBrush}" CornerRadius="21" Margin="2,5,2,-2" IsHitTestVisible="False"/>
                    <Border Style="{StaticResource CardPanel}" Padding="10" CornerRadius="21">
                    <Grid RowSpacing="0"><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="14"><Grid x:Name="CoverFrame" SizeChanged="CoverFrame_SizeChanged"><controls:LineIcon Kind="Library" Width="34" Height="34" Foreground="{ThemeResource MutedBrush}" Opacity="0.35"/><Image x:Name="VideoCover" Source="{Binding Thumbnail, Converter={StaticResource ThumbnailConverter}}" Stretch="UniformToFill"/><Border Background="#DCFDEEF0" BorderBrush="#FFDDE1" BorderThickness="1" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Visibility="{Binding IsMissing, Converter={StaticResource MissingVisibilityConverter}}"><TextBlock controls:Localized.Text="文件已移走" Foreground="#A54C59" FontSize="10" TextWrapping="Wrap"/></Border><Border Background="#88437092" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9" Padding="8,4"><TextBlock Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" Foreground="White" FontSize="10"/></Border><Border Background="#885A6677" BorderBrush="#F5FFFFFF" BorderThickness="1.2" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="9"><controls:LineIcon Kind="Play" Foreground="White" Width="20" Height="20"/></Border></Grid></Border>
                      <Button Style="{StaticResource GlassButton}" Width="32" Height="32" Padding="6" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9" Tag="{x:Bind}" Click="MediaMore_Click" controls:Localized.ToolTip="更多操作" controls:Localized.Name="更多操作"><controls:LineIcon Kind="More" Width="20" Height="20"/></Button>
                      <Grid Grid.Row="1" Padding="2,12,1,2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Title, Mode=OneWay}" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,8,0"/><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{x:Bind Author, Mode=OneWay}" MaxWidth="75" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" FontSize="10"/><Border Background="{ThemeResource AccentSoftBrush}" BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Visibility="{Binding Quality, Converter={StaticResource NonEmptyVisibilityConverter}}"><TextBlock Text="{Binding Quality, Converter={StaticResource ErrorLocalizationConverter}}" Foreground="{ThemeResource AccentBrush}" FontSize="10"/></Border><TextBlock Text="{Binding CompletedAt, Converter={StaticResource DateConverter}}" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel><Button Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource GlassButton}" Width="40" Height="40" Padding="9" CornerRadius="12" VerticalAlignment="Center" Tag="{x:Bind}" Click="Locate_Click" controls:Localized.ToolTip="在文件夹中查看" controls:Localized.Name="在文件夹中查看"><controls:LineIcon Kind="Folder" Width="20" Height="20"/></Button></Grid>
                    </Grid>
                    </Border>
                    <Border BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" CornerRadius="21" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource MissingVisibilityConverter}}"><Border Width="24" Height="24" CornerRadius="12" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentButtonForeground}"/></Border></Border>
                  </Grid>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="LibraryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource MutedBrush}" Opacity="0.4"/><TextBlock x:Name="LibraryEmptyTitle" Text="" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"/><TextBlock controls:Localized.Text="下载完成的视频会出现在这里，也可以导入旧版下载目录。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" MaxWidth="350" TextAlignment="Center"/></StackPanel>
          </Grid>
        </Grid>
        </ContentControl>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="22" Padding="2,4,2,10">
