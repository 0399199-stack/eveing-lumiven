                <TextBlock controls:Localized.Text="请通过官方 GitHub 仓库免费获取安装包及后续更新。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassPanel}"><Grid><StackPanel Spacing="8"><TextBlock controls:Localized.Text="联系 EVEING" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/><HyperlinkButton NavigateUri="mailto:0399199@gmail.com" Content="0399199@gmail.com" Padding="0" HorizontalAlignment="Left"/></StackPanel><FontIcon Glyph="&#xE715;" FontSize="28" Foreground="{ThemeResource AccentBrush}" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid></Border>
    </Grid>
    <Border x:Name="PlayerOverlay" Visibility="Collapsed" Background="#F00B1220" CornerRadius="0" Padding="28" Margin="0,58,0,0">
      <Grid RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource GlassButton}" Click="ClosePlayer_Click" controls:Localized.Name="返回媒体库"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="PlayerTitle" Foreground="White" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayerAuthor" Foreground="#A7B6CF" FontSize="12"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GlassButton}" Click="Fullscreen_Click" controls:Localized.ToolTip="切换全屏" controls:Localized.Name="切换全屏"><FontIcon Glyph="&#xE740;" FontSize="16"/></Button></Grid>
