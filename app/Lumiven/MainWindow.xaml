            <Border Style="{StaticResource GlassPanel}">
              <StackPanel Spacing="18">
                <TextBlock controls:Localized.Text="外观与语言" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" TextWrapping="Wrap"/>
